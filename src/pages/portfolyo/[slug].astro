---
import Base from '@/layouts/Base.astro'
import { getPublishedSlugs } from '@/lib/data'
import { CaseStudyPage, meta } from '@/views/CaseStudyView'

export function getStaticPaths() {
  return getPublishedSlugs('projects').map((slug) => ({ params: { slug } }))
}

const { slug } = Astro.params
---

<Base meta={meta({ slug: slug! })}><CaseStudyPage slug={slug!} /></Base>
