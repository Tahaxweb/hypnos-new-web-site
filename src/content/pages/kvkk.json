                  "direction": "ltr",
                  "format": "",
                  "indent": 0,
                  "version": 1,
                  "value": 1
                },
                {
                  "type": "listitem",
                  "children": [
                    {
                      "type": "text",
                      "text": "Talep edilmesi hâlinde yetkili kamu kurum ve kuruluşları (hukuki yükümlülükler kapsamında)",
