              "direction": "ltr",
              "format": "",
              "indent": 0,
              "version": 1,
              "textFormat": 0,
              "textStyle": ""
            },
            {
              "type": "heading",
              "children": [
                {
                  "type": "text",
                  "text": "7. Saklama süresi",
                  "format": 0,
                  "detail": 0,
                  "mode": "normal",
                  "style": "",
                  "version": 1
