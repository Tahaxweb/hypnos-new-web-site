              "direction": "ltr",
              "format": "",
              "indent": 0,
              "version": 1,
              "textFormat": 0,
              "textStyle": ""
            },
            {
              "type": "list",
              "children": [
                {
                  "type": "listitem",
                  "children": [
                    {
                      "type": "text",
                      "text": "Web sitesinin barındırıldığı sunucu ve veritabanı hizmet sağlayıcıları ile e-posta hizmet sağlayıcıları (hizmetin teknik olarak sunulabilmesi için)",
