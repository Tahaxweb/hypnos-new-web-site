# Sitenin yayındaki adresi (canonical, sitemap, Open Graph için)
PUBLIC_SERVER_URL=https://www.hypnosinteractive.com

# Yalnız canlı ortamda "production". Diğer ortamlarda robots.txt ve meta robots tüm siteyi kapatır.
# Bu değer derleme sırasında okunur.
PUBLIC_SITE_ENV=

# İletişim talepleri bu klasördeki iletisim-talepleri.jsonl dosyasına yazılır (varsayılan ./data)
# CONTACT_DATA_DIR=./data
# Opsiyonel: her talep ayrıca bu adrese JSON olarak POST edilir (Zapier, Make, n8n, e-posta servisi vb.)
# CONTACT_WEBHOOK_URL=
