# Vercel > Project Settings > Environment Variables bölümüne girin.

# Sitenin yayındaki adresi (canonical, sitemap, Open Graph için) — derleme sırasında okunur
PUBLIC_SERVER_URL=https://www.hypnosinteractive.com

# Yalnız Production ortamında "production". Aksi halde robots.txt ve meta robots siteyi arama motorlarına kapatır.
PUBLIC_SITE_ENV=production

# İletişim formu: en az biri gerekli (canlıda yoksa form hata döner)
RESEND_API_KEY=
CONTACT_TO=            # boşsa site ayarlarındaki e-posta
CONTACT_FROM=          # Resend'de doğrulanmış gönderen, örn. "Hypnos Interactive <iletisim@alanadiniz.com>"
# CONTACT_WEBHOOK_URL=  # alternatif: talebi JSON olarak POST eder
